# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local ไม่ถูก commit)
# ค่าของ Supabase local ดูได้จาก `npx supabase status`
# ค่าของ project จริงดูได้ที่ Supabase Dashboard > Project Settings > API

# ---- ใช้ได้ทั้งฝั่งเบราว์เซอร์และเซิร์ฟเวอร์ ----
# local: http://127.0.0.1:54321
# จริง: https://anyvflatoeedytlrntmp.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# publishable key (sb_publishable_...) เปิดเผยได้ ความปลอดภัยมาจาก RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# โหมดตัวนับจำนวนผู้ส่งฝั่งนิสิต: realtime (ค่าเริ่มต้น) | polling (ถามทุก 5 วินาที)
NEXT_PUBLIC_COUNT_MODE=realtime

# URL ของเว็บ ใช้สร้าง redirect ของ Google OAuth และลิงก์หน้าอันดับ /r/[token]
# local: http://localhost:3000  | จริง: https://<ชื่อโปรเจกต์>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- เฉพาะเซิร์ฟเวอร์เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ ----
# service role / secret key: ใช้เฉพาะใน server route ของ Next.js ที่ตรวจสิทธิ์อาจารย์แล้ว
SUPABASE_SERVICE_ROLE_KEY=

# ---- เฉพาะ Supabase CLI ตอนรัน local (อ่านโดย supabase/config.toml) ----
# ใส่เมื่อเปิด Google login ในระยะที่ 2; ใส่ไว้ใน supabase/.env (ไม่ถูก commit)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
